{"kind":{"type":"frontMatter","text":"title: \"Push shows no count on a branch with no upstream config: gix's tracking-ref helper skips the origin fallback\"\u000adate: 2026-09-29\u000acategory: integration-issues\u000amodule: rc-git-guard\u000aproblem_type: integration_issue\u000acomponent: infrastructure\u000asymptoms:\u000a  - \"The Push button never shows an unpushed-commit count on a branch made with `git init` and pushed without `-u`, while cloned and `push -u` branches count fine\"\u000a  - \"`upstream_status` reports has_upstream true with an empty upstream_ref and ahead/behind 0/0\"\u000a  - \"Before the fix, Pull and Sync failed with NoUpstream on that branch even though Fetch and Push to origin succeeded\"\u000a  - \"Nothing errors: gix's `branch_remote_tracking_ref_name` answers None, not an Err, when `branch.<name>.merge` is missing\"\u000aroot_cause: logic_error\u000aresolution_type: code_fix\u000aseverity: high\u000aframework_version: gix 0.87.1\u000arelated_components:\u000a  - rc-git-ffi\u000a  - RcGitKit\u000a  - RcGitApp\u000atags: [gix, upstream, remote-tracking-ref, ahead-behind, branch-merge-config, origin-fallback, push, pull]"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":1},"runs":[{"text":"Push shows no count on a branch with no upstream config: gix's tracking-ref helper skips the origin fallback","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Problem","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"A branch with no ","style":[],"link":null,"image":false},{"text":"[branch \"<name>\"]","style":["code"],"link":null,"image":false},{"text":" section in ","style":[],"link":null,"image":false},{"text":".git/config","style":["code"],"link":null,"image":false},{"text":" got its remote from one helper and its remote-tracking ref from another, and only the first had a fallback. That happens after ","style":[],"link":null,"image":false},{"text":"git init","style":["code"],"link":null,"image":false},{"text":" plus a push without ","style":[],"link":null,"image":false},{"text":"-u","style":["code"],"link":null,"image":false},{"text":". ","style":[],"link":null,"image":false},{"text":"configured_remote_name","style":["code"],"link":null,"image":false},{"text":" fell back to ","style":[],"link":null,"image":false},{"text":"origin","style":["code"],"link":null,"image":false},{"text":", so fetch and push worked and the app reported an upstream. ","style":[],"link":null,"image":false},{"text":"tracking_ref_name","style":["code"],"link":null,"image":false},{"text":" asked gix, got nothing, and returned ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":". So the Changes tab showed a bare \"Push\" with no count, and Pull and Sync failed with ","style":[],"link":null,"image":false},{"text":"NoUpstream","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Symptoms","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The Changes tab's Push button read \"Push\", with no commit count, while ","style":[],"link":null,"image":false},{"text":"git rev-list --count origin/master..master","style":["code"],"link":null,"image":false},{"text":" printed 46 at the time. ","style":[],"link":null,"image":false},{"text":"SyncTitles.push","style":["code"],"link":null,"image":false},{"text":" shows the bare verb whenever ","style":[],"link":null,"image":false},{"text":"ahead","style":["code"],"link":null,"image":false},{"text":" is 0 (","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitKit/SyncModel.swift","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"It depended on the branch. Counts showed on branches and repositories whose config names an upstream (a clone, or a branch pushed with ","style":[],"link":null,"image":false},{"text":"-u","style":["code"],"link":null,"image":false},{"text":") and never on the affected branch, so it looked like a timing problem.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"The affected repository's ","style":[],"link":null,"image":false},{"text":".git/config","style":["code"],"link":null,"image":false},{"text":" had ","style":[],"link":null,"image":false},{"text":"[remote \"origin\"]","style":["code"],"link":null,"image":false},{"text":" and no ","style":[],"link":null,"image":false},{"text":"[branch \"master\"]","style":["code"],"link":null,"image":false},{"text":" section. This repository's own checkout had that shape when this was written.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Nothing reported an error. ","style":[],"link":null,"image":false},{"text":"upstream_status","style":["code"],"link":null,"image":false},{"text":" returned ","style":[],"link":null,"image":false},{"text":"has_upstream: true","style":["code"],"link":null,"image":false},{"text":" with ","style":[],"link":null,"image":false},{"text":"upstream_ref: \"\"","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"(ahead, behind) = (0, 0)","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/remote.rs","style":["code"],"link":null,"image":false},{"text":"). The sync preflight only blocks when ","style":[],"link":null,"image":false},{"text":"hasUpstream","style":["code"],"link":null,"image":false},{"text":" is false (","style":[],"link":null,"image":false},{"text":"SyncModel.adoptFreshUpstream","style":["code"],"link":null,"image":false},{"text":"), so the app treated the branch as tracked.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Pull failed with ","style":[],"link":null,"image":false},{"text":"ActionError::NoUpstream","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"upstream_tip","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/remote/pull.rs","style":["code"],"link":null,"image":false},{"text":"). Sync runs fetch, then pull, then push, and stops at the first failure (","style":[],"link":null,"image":false},{"text":"SyncModel.sync()","style":["code"],"link":null,"image":false},{"text":"), so it failed at the pull step and never pushed. Push on its own succeeded.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"heading","level":2},"runs":[{"text":"What Didn't Work","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Suspecting refresh timing.","style":["strong"],"link":null,"image":false},{"text":" Counts appeared on some branches and not on others, so the first guess was a stale status: ","style":[],"link":null,"image":false},{"text":"SyncModel.refreshStatus","style":["code"],"link":null,"image":false},{"text":" or the ref watcher not re-reading after a push. Reading the repository's ","style":[],"link":null,"image":false},{"text":".git/config","style":["code"],"link":null,"image":false},{"text":" and gix's branch helpers ruled this out. The status was not stale. On this branch it came out wrong on every read, because the tracking-ref lookup could never succeed without a ","style":[],"link":null,"image":false},{"text":"branch.master.merge","style":["code"],"link":null,"image":false},{"text":" key.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Trusting the existing tests.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"push_creates_a_new_branch_from_an_existing_commit","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/tests/remote.rs","style":["code"],"link":null,"image":false},{"text":") already pushes a branch made with ","style":[],"link":null,"image":false},{"text":"checkout -b","style":["code"],"link":null,"image":false},{"text":" from a local branch, which by git's default gets no upstream config, and it passes. It never calls ","style":[],"link":null,"image":false},{"text":"upstream_status","style":["code"],"link":null,"image":false},{"text":" afterwards, and that call is where the two helpers disagreed. Before the fix, the status tests that had a remote only used clones, which always have ","style":[],"link":null,"image":false},{"text":"branch.main.merge","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Setting the upstream by hand.","style":["strong"],"link":null,"image":false},{"text":" Wrap-ups in earlier sessions noted this ","style":[],"link":null,"image":false},{"text":"master","style":["code"],"link":null,"image":false},{"text":" as ahead of ","style":[],"link":null,"image":false},{"text":"origin/master","style":["code"],"link":null,"image":false},{"text":" with \"no upstream tracking set\" and suggested ","style":[],"link":null,"image":false},{"text":"git push -u origin master","style":["code"],"link":null,"image":false},{"text":" (session history). That writes ","style":[],"link":null,"image":false},{"text":"branch.master.merge","style":["code"],"link":null,"image":false},{"text":" and makes the count appear, but it only hides the bug for that one branch. It also fixes nothing for Pull and Sync on any other branch pushed without ","style":[],"link":null,"image":false},{"text":"-u","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Solution","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"tracking_ref_name","style":["code"],"link":null,"image":false},{"text":" now handles gix's ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" itself. It picks the remote with the same ","style":[],"link":null,"image":false},{"text":"configured_remote_name","style":["code"],"link":null,"image":false},{"text":" that fetch and push use, and returns where that remote's fetch refspecs file ","style":[],"link":null,"image":false},{"text":"refs/heads/<branch>","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"fetched_into","style":["code"],"link":null,"image":false},{"text":"), e.g. ","style":[],"link":null,"image":false},{"text":"refs/remotes/origin/master","style":["code"],"link":null,"image":false},{"text":". Push asks ","style":[],"link":null,"image":false},{"text":"push_refs","style":["code"],"link":null,"image":false},{"text":" for its tracking ref, which maps the branch through the same ","style":[],"link":null,"image":false},{"text":"fetched_into","style":["code"],"link":null,"image":false},{"text":", and ","style":[],"link":null,"image":false},{"text":"update_tracking_ref","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/remote/push.rs","style":["code"],"link":null,"image":false},{"text":") moves that ref after the push.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Before (the first version of the helper):","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"rust","text":"fn tracking_ref_name(repo: &gix::Repository, branch: &str) -> Option<String> {\u000a    let full = format!(\"refs/heads/{branch}\");\u000a    let full_name: gix::refs::FullName = full.as_str().try_into().ok()?;\u000a    let tracking = repo\u000a        .branch_remote_tracking_ref_name(full_name.as_ref(), gix::remote::Direction::Fetch)?\u000a        .ok()?;\u000a    Some(tracking.as_bstr().to_string())\u000a}"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"After, as ","style":[],"link":null,"image":false},{"text":"tracking_ref_name","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/remote.rs","style":["code"],"link":null,"image":false},{"text":" reads today (doc comment and lint opt-out trimmed):","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"rust","text":"fn tracking_ref_name(\u000a    repo: &gix::Repository,\u000a    branch: &str,\u000a    op: &'static str,\u000a) -> ActionResult<Option<TrackingRef>> {\u000a    let Some(remote) = configured_remote_name(repo, branch, Direction::Fetch) else {\u000a        return Ok(None);\u000a    };\u000a    if remote == LOCAL_REMOTE {\u000a        return Ok(merge_ref_name(repo, branch).map(|name| TrackingRef {\u000a            name: Some(name),\u000a            configured: true,\u000a        }));\u000a    }\u000a    let full = format!(\"refs/heads/{branch}\");\u000a    let full_name: gix::refs::FullName = full.as_str().try_into().map_err(git_err(op, &full))?;\u000a    let configured = repo.branch_remote_tracking_ref_name(full_name.as_ref(), Direction::Fetch);\u000a    let Some(tracking) = configured else {\u000a        if !is_named_remote(repo, &remote) {\u000a            return Ok(None);\u000a        }\u000a        return Ok(Some(TrackingRef {\u000a            name: fetched_into(repo, &remote, &full, op)?,\u000a            configured: false,\u000a        }));\u000a    };\u000a    let name = tracking.map_err(git_err(op, &full))?;\u000a    Ok(Some(TrackingRef {\u000a        name: Some(name.as_bstr().to_string()),\u000a        configured: true,\u000a    }))\u000a}"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The function has grown since the fix: it returns an error rather than ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" when gix reports a broken config (","style":[],"link":null,"image":false},{"text":"Some(Err(_))","style":["code"],"link":null,"image":false},{"text":"), answers the local branch for a local upstream (","style":[],"link":null,"image":false},{"text":"remote = .","style":["code"],"link":null,"image":false},{"text":"), ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" for a URL upstream, and records in ","style":[],"link":null,"image":false},{"text":"configured","style":["code"],"link":null,"image":false},{"text":" whether ","style":[],"link":null,"image":false},{"text":"branch.<name>.merge","style":["code"],"link":null,"image":false},{"text":" named the ref. The fallback runs on every ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" from gix: a missing merge or remote key, or a remote whose fetch refspecs are empty or do not map the branch; in the last two cases ","style":[],"link":null,"image":false},{"text":"fetched_into","style":["code"],"link":null,"image":false},{"text":" answers ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" and there is no tracking ref to count against.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"A branch that was never pushed has no ref at the fallback name yet. That is not an error: ","style":[],"link":null,"image":false},{"text":"upstream_status","style":["code"],"link":null,"image":false},{"text":" reports ","style":[],"link":null,"image":false},{"text":"published: false","style":["code"],"link":null,"image":false},{"text":", and ","style":[],"link":null,"image":false},{"text":"pull_fast_forward","style":["code"],"link":null,"image":false},{"text":" returns an already-up-to-date outcome with ","style":[],"link":null,"image":false},{"text":"unpublished: true","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"upstream_tip","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"pull.rs","style":["code"],"link":null,"image":false},{"text":"), since ","style":[],"link":null,"image":false},{"text":"configured","style":["code"],"link":null,"image":false},{"text":" is false. ","style":[],"link":null,"image":false},{"text":"NoUpstream","style":["code"],"link":null,"image":false},{"text":" is left for a branch where no remote resolves at all.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Tests in ","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/tests/remote.rs","style":["code"],"link":null,"image":false},{"text":", both failing before the fix:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The ","style":[],"link":null,"image":false},{"text":"untrack","style":["code"],"link":null,"image":false},{"text":" helper runs ","style":[],"link":null,"image":false},{"text":"git branch --unset-upstream main","style":["code"],"link":null,"image":false},{"text":" on a clone. That removes ","style":[],"link":null,"image":false},{"text":"branch.main.remote","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"branch.main.merge","style":["code"],"link":null,"image":false},{"text":" and leaves ","style":[],"link":null,"image":false},{"text":"origin","style":["code"],"link":null,"image":false},{"text":" in place, which is the same state as the affected repository.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
