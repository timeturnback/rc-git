{"kind":{"type":"code","language":"sh","text":"scripts/check.sh                  # CI's checks minus build-app.sh; --fast skips the Swift half\u000acargo test --workspace            # Rust tests; fixtures are built with the git CLI\u000acargo clippy --workspace --all-targets --all-features -- -D warnings\u000ascripts/build.sh [debug]          # Rust lib + header + swift build (debug: app-dev profile)\u000aswift test --package-path mac     # RcGitKit tests; run scripts/build.sh once first\u000ascripts/build-app.sh [--dev]      # assemble RCGit.app, or RCGit-dev.app, ad-hoc signed\u000ascripts/install-app.sh            # build the release bundle into /Applications\u000acargo run -p rc-git-cli -- --time ls <repo> [rev] [path]   # CLI and benchmark tool"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Needs ","style":[],"link":null,"image":false},{"text":"rustup","style":["code"],"link":null,"image":false},{"text":" (Rust is pinned in ","style":[],"link":null,"image":false},{"text":"rust-toolchain.toml","style":["code"],"link":null,"image":false},{"text":"), ","style":[],"link":null,"image":false},{"text":"cargo install cbindgen --version 0.29.4 --locked","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"brew install cargo-deny prek shellcheck shfmt actionlint zizmor","style":["code"],"link":null,"image":false},{"text":", and Xcode 27 or newer. ","style":[],"link":null,"image":false},{"text":"docs/development.md","style":["code"],"link":null,"image":false},{"text":" has the rest.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
