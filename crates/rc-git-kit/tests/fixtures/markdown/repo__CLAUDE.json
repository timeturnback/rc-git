{"kind":{"type":"table","alignments":["natural","natural","natural"],"header":[[{"text":"Path","style":[],"link":null,"image":false}],[{"text":"Contains","style":[],"link":null,"image":false}],[{"text":"Tested","style":[],"link":null,"image":false}]],"rows":[[[{"text":"crates/rc-git-core","style":["code"],"link":null,"image":false}],[{"text":"gix wrapper: open, refs, trees, blobs, log, diff, blame, worktree. Keyed by ","style":[],"link":null,"image":false},{"text":"Oid","style":["code"],"link":null,"image":false},{"text":". No gix types in the public API.","style":[],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"crates/rc-git-guard","style":["code"],"link":null,"image":false}],[{"text":"policy for every mutating action, and the one write and network path (","style":[],"link":null,"image":false},{"text":"docs/safety.md","style":["code"],"link":null,"image":false},{"text":", \"Guarding mutations\").","style":[],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"crates/rc-git-highlight","style":["code"],"link":null,"image":false}],[{"text":"tree-sitter highlighting and import links: bytes in, spans out. Pure.","style":[],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"crates/rc-git-ffi","style":["code"],"link":null,"image":false}],[{"text":"C ABI over core, guard, and highlight. The only crate allowed ","style":[],"link":null,"image":false},{"text":"unsafe","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"crates/rc-git-cli","style":["code"],"link":null,"image":false}],[{"text":"rc-git","style":["code"],"link":null,"image":false},{"text":" binary: scriptable access plus ","style":[],"link":null,"image":false},{"text":"--time","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"crates/rc-git-testkit","style":["code"],"link":null,"image":false}],[{"text":"fixture repositories built with the git CLI. The only crate that shells out.","style":[],"link":null,"image":false}],[{"text":"—","style":[],"link":null,"image":false}]],[[{"text":"mac/Sources/RcGitKit","style":["code"],"link":null,"image":false}],[{"text":"Swift wrapper, ","style":[],"link":null,"image":false},{"text":"BrowserModel","style":["code"],"link":null,"image":false},{"text":", layout policy, the markdown parser, link and import resolution. ","style":[],"link":null,"image":false},{"text":"No AppKit.","style":["strong"],"link":null,"image":false}],[{"text":"yes","style":[],"link":null,"image":false}]],[[{"text":"mac/Sources/RcGitApp","style":["code"],"link":null,"image":false}],[{"text":"AppKit windows and views. Marshals events to the model, nothing else.","style":[],"link":null,"image":false}],[{"text":"no","style":[],"link":null,"image":false}]]]},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"New logic goes in ","style":[],"link":null,"image":false},{"text":"rc-git-core","style":["code"],"link":null,"image":false},{"text":" when it reads git data and in ","style":[],"link":null,"image":false},{"text":"RcGitKit","style":["code"],"link":null,"image":false},{"text":" when it is app state or pure text logic the views need decided once. ","style":[],"link":null,"image":false},{"text":"RcGitApp","style":["code"],"link":null,"image":false},{"text":" only wires views to the model. The FFI layer only marshals; ","style":[],"link":null,"image":false},{"text":"docs/ffi.md","style":["code"],"link":null,"image":false},{"text":" has the checklist for adding a function, and ","style":[],"link":null,"image":false},{"text":"scripts/gen-header.sh --verify","style":["code"],"link":null,"image":false},{"text":" fails when the committed header drifts.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Working agreement","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Never launch the app to verify a change. Build, lint, and tests are the scope; the user runs ","style":[],"link":null,"image":false},{"text":"RCGit.app","style":["code"],"link":null,"image":false},{"text":" and reports what breaks. Reproduce and measure with the CLI instead.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"The release and dev bundles differ only by ","style":[],"link":null,"image":false},{"text":"CFBundleIdentifier","style":["code"],"link":null,"image":false},{"text":", name, icon, and build config. That identifier scopes ","style":[],"link":null,"image":false},{"text":"UserDefaults","style":["code"],"link":null,"image":false},{"text":", so it is what keeps their tabs apart and what carries tabs through a self-update — never make it depend on a version or build number.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Both bundles rebuild themselves by running ","style":[],"link":null,"image":false},{"text":"scripts/build-app.sh","style":["code"],"link":null,"image":false},{"text":", so that script assembles into ","style":[],"link":null,"image":false},{"text":"build/stage/","style":["code"],"link":null,"image":false},{"text":" and deletes the old bundle last. Never delete it before the build: the dev bundle is the process running the script.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
