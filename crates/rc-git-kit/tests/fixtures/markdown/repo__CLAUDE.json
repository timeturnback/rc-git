{"kind":{"type":"heading","level":1},"runs":[{"text":"rc-git","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Native macOS git browser built for speed: open a repository, pick a branch or tag, walk the tree, read files, page history, diff, blame, browse the working tree. A Rust core on ","style":[],"link":null,"image":false},{"text":"gitoxide","style":["code"],"link":null,"image":false},{"text":" reads the object database directly; a thin AppKit app renders it. The core spawns no process (no ","style":[],"link":null,"image":false},{"text":"git","style":["code"],"link":null,"image":false},{"text":" process for repository operations) and never writes; every write — refs, objects, the index, working-tree files, stash, fetch/pull/push — goes through ","style":[],"link":null,"image":false},{"text":"rc-git-guard","style":["code"],"link":null,"image":false},{"text":". The in-app updater runs ","style":[],"link":null,"image":false},{"text":"scripts/install-app.sh","style":["code"],"link":null,"image":false},{"text":" or ","style":[],"link":null,"image":false},{"text":"build-app.sh","style":["code"],"link":null,"image":false},{"text":", which call ","style":[],"link":null,"image":false},{"text":"git","style":["code"],"link":null,"image":false},{"text":" on rc-git's own checkout, never on a browsed repository.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Two rules define the project. A change that breaks either is wrong even when it works:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The core never writes.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"clippy.toml","style":["code"],"link":null,"image":false},{"text":" bans the gix and std write, spawn and network entry points it lists; ","style":[],"link":null,"image":false},{"text":"crates/rc-git-core/tests/read_only.rs","style":["code"],"link":null,"image":false},{"text":" proves ","style":[],"link":null,"image":false},{"text":".git","style":["code"],"link":null,"image":false},{"text":" is byte-identical after every operation. The one write path is ","style":[],"link":null,"image":false},{"text":"rc-git-guard","style":["code"],"link":null,"image":false},{"text":"'s ","style":[],"link":null,"image":false},{"text":"actions","style":["code"],"link":null,"image":false},{"text":" module (see ","style":[],"link":null,"image":false},{"text":".claude/rules/guard.md","style":["code"],"link":null,"image":false},{"text":"); every mutation goes through it. Say so rather than bypassing it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Nothing scales with repository size except what is on screen.","style":["strong"],"link":null,"image":false},{"text":" One tree object per folder expand, one blob per file view, a header read before any decode, one log page at a time. ","style":[],"link":null,"image":false},{"text":"docs/performance.md","style":["code"],"link":null,"image":false},{"text":" has the budgets and the lazy rules.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
