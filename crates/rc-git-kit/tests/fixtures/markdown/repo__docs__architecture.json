":["code"],"link":null,"image":false}],[{"text":"on ","style":[],"link":null,"image":false},{"text":"attach","style":["code"],"link":null,"image":false},{"text":"; 4 most recent kept","style":[],"link":null,"image":false}]],[[{"text":"flattened file lists (path search)","style":[],"link":null,"image":false}],[{"text":"root tree id","style":[],"link":null,"image":false}],[{"text":"BrowserModel","style":["code"],"link":null,"image":false}],[{"text":"on ","style":[],"link":null,"image":false},{"text":"attach","style":["code"],"link":null,"image":false},{"text":"; 2 most recent roots kept","style":[],"link":null,"image":false}]],[[{"text":"syntax spans","style":[],"link":null,"image":false}],[{"text":"blob id","style":[],"link":null,"image":false}],[{"text":"BrowserModel.highlightCache","style":["code"],"link":null,"image":false}],[{"text":"on ","style":[],"link":null,"image":false},{"text":"attach","style":["code"],"link":null,"image":false},{"text":"; least recently used evicted past 16 files or 1,500,000 spans","style":[],"link":null,"image":false}]],[[{"text":"import links","style":[],"link":null,"image":false}],[{"text":"blob id","style":[],"link":null,"image":false}],[{"text":"BrowserModel.importLinkCache","style":["code"],"link":null,"image":false}],[{"text":"on ","style":[],"link":null,"image":false},{"text":"attach","style":["code"],"link":null,"image":false},{"text":", and with the blob's spans","style":[],"link":null,"image":false}]],[[{"text":"row symbols","style":[],"link":null,"image":false}],[{"text":"symbol name","style":[],"link":null,"image":false}],[{"text":"Icons","style":["code"],"link":null,"image":false},{"text":" in RcGitApp","style":[],"link":null,"image":false}],[{"text":"never","style":[],"link":null,"image":false}]]]},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Refs are not cached across calls; ","style":[],"link":null,"image":false},{"text":"refs()","style":["code"],"link":null,"image":false},{"text":" re-reads ","style":[],"link":null,"image":false},{"text":"packed-refs","style":["code"],"link":null,"image":false},{"text":" and loose refs each time and is cheap enough to call on every change. ","style":[],"link":null,"image":false},{"text":"RefWatcher","style":["code"],"link":null,"image":false},{"text":" (RcGitKit) watches the ","style":[],"link":null,"image":false},{"text":".git","style":["code"],"link":null,"image":false},{"text":" directory with FSEvents. ","style":[],"link":null,"image":false},{"text":"RefWatchFilter","style":["code"],"link":null,"image":false},{"text":" keeps only events on ","style":[],"link":null,"image":false},{"text":"HEAD","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"packed-refs","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"config","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"refs/","style":["code"],"link":null,"image":false},{"text":", and each burst calls ","style":[],"link":null,"image":false},{"text":"BrowserModel.refreshRefs()","style":["code"],"link":null,"image":false},{"text":", which re-reads refs and keeps every object cache.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null}
