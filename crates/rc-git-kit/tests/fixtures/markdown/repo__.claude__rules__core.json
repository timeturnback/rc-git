{"kind":{"type":"frontMatter","text":"description: rc-git-core is a read-only gix wrapper; what may enter it and what never may\u000apaths: crates/rc-git-core/**"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":1},"runs":[{"text":"rc-git-core","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Never call a gix write API, mutate the working tree, or spawn a process. ","style":[],"link":null,"image":false},{"text":"clippy.toml","style":["code"],"link":null,"image":false},{"text":" lists what is banned; if clippy accepts something that writes, it is still banned. Add it to the list. ","style":[],"link":null,"image":false},{"text":"worktree.rs","style":["code"],"link":null,"image":false},{"text":" reads the working directory with ","style":[],"link":null,"image":false},{"text":"std::fs","style":["code"],"link":null,"image":false},{"text":" reads only; keep it that way.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"No gix types in the public API except the ","style":[],"link":null,"image":false},{"text":"bstr","style":["code"],"link":null,"image":false},{"text":" re-export. Wrap in ","style":[],"link":null,"image":false},{"text":"Oid","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"TreeEntry","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"CommitSummary","style":["code"],"link":null,"image":false},{"text":", so the FFI and Swift never chase gix releases.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Every operation runs inside ","style":[],"link":null,"image":false},{"text":"Repository::with","style":["code"],"link":null,"image":false},{"text":". Never keep a ","style":[],"link":null,"image":false},{"text":"gix::Repository","style":["code"],"link":null,"image":false},{"text":" beyond one call: the pool lends one per call and builds a temporary handle when all are busy.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Every ","style":[],"link":null,"image":false},{"text":"Error","style":["code"],"link":null,"image":false},{"text":" message names what failed and the thing it failed on (path, spec, oid, or op plus path/oid). A new variant needs a test of its full message in ","style":[],"link":null,"image":false},{"text":"error.rs","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Read a header before decoding a blob, and honor the caller's limit. A huge blob must cost one header read, never a decode.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Adding a read operation: core fn with ","style":[],"link":null,"image":false},{"text":"# Errors","style":["code"],"link":null,"image":false},{"text":" docs, a case in the matching ","style":[],"link":null,"image":false},{"text":"crates/rc-git-core/tests/<area>.rs","style":["code"],"link":null,"image":false},{"text":" (repository, diff_blame, history, worktree, stash), call in ","style":[],"link":null,"image":false},{"text":"tests/read_only.rs","style":["code"],"link":null,"image":false},{"text":", FFI function and header, Swift wrapper and test, CLI subcommand when scriptable. ","style":[],"link":null,"image":false},{"text":"docs/ffi.md","style":["code"],"link":null,"image":false},{"text":" has the FFI half.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Fixtures come from ","style":[],"link":null,"image":false},{"text":"rc-git-testkit","style":["code"],"link":null,"image":false},{"text":". Write ","style":[],"link":null,"image":false},{"text":".git","style":["code"],"link":null,"image":false},{"text":" internals by hand only to simulate corruption, as ","style":[],"link":null,"image":false},{"text":"a_broken_ref_is_reported_without_hiding_the_rest","style":["code"],"link":null,"image":false},{"text":" does.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"History pages resume through a walk handle (","style":[],"link":null,"image":false},{"text":"LogCursor","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"HistoryWalk","style":["code"],"link":null,"image":false},{"text":") that owns its traversal and object-database handle, never a pooled ","style":[],"link":null,"image":false},{"text":"gix::Repository","style":["code"],"link":null,"image":false},{"text":"; never re-walk from the tip with an offset, and never restart from saved frontier oids — without the seen set a commit reachable from two of them, or tied on time, comes back twice. Filtered pages report ","style":[],"link":null,"image":false},{"text":"scanned","style":["code"],"link":null,"image":false},{"text":"/","style":[],"link":null,"image":false},{"text":"complete","style":["code"],"link":null,"image":false},{"text":" and cap examined commits with ","style":[],"link":null,"image":false},{"text":"max_scan","style":["code"],"link":null,"image":false},{"text":", so no call holds a pool handle through a long scan. A time floor maps to ","style":[],"link":null,"image":false},{"text":"Sorting::ByCommitTimeCutoff","style":["code"],"link":null,"image":false},{"text":", which terminates the walk instead of filtering; gix 0.87 has no topo order in ","style":[],"link":null,"image":false},{"text":"rev_walk","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"The working-tree status walk reads the index as a stat cache (","style":[],"link":null,"image":false},{"text":"StatCache","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"worktree.rs","style":["code"],"link":null,"image":false},{"text":") so an unchanged file costs one ","style":[],"link":null,"image":false},{"text":"lstat","style":["code"],"link":null,"image":false},{"text":" instead of a full hash. It may only ever ","style":[],"link":null,"image":false},{"text":"decline","style":["emphasis"],"link":null,"image":false},{"text":": a conflicted, assume-valid, skip-worktree, intent-to-add or racy entry, an id that is not the tree's, or any read that fails falls through to hashing. Never let it answer ","style":[],"link":null,"image":false},{"text":"Unchanged","style":["code"],"link":null,"image":false},{"text":" from anything but a full stat match — that hides a real edit. The walk takes one ","style":[],"link":null,"image":false},{"text":"lstat","style":["code"],"link":null,"image":false},{"text":" per entry, as ","style":[],"link":null,"image":false},{"text":"DiskStat","style":["code"],"link":null,"image":false},{"text":" (gix's ","style":[],"link":null,"image":false},{"text":"Metadata","style":["code"],"link":null,"image":false},{"text":", which fills ","style":[],"link":null,"image":false},{"text":"ctime","style":["code"],"link":null,"image":false},{"text":" as git does), and hands it to the cache in ","style":[],"link":null,"image":false},{"text":"DiskFacts","style":["code"],"link":null,"image":false},{"text":"; never stat the same path again.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Compare a directory against its tree through ","style":[],"link":null,"image":false},{"text":"FsRules::index","style":["code"],"link":null,"image":false},{"text":", not a scan per file. A wide directory otherwise costs a pass over the whole tree listing for every file in it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Name a disk entry with ","style":[],"link":null,"image":false},{"text":"FsRules::disk_name","style":["code"],"link":null,"image":false},{"text":" and match it with ","style":[],"link":null,"image":false},{"text":"TreeIndex::resolve","style":["code"],"link":null,"image":false},{"text":": macOS returns NFD names git stores as NFC, and ","style":[],"link":null,"image":false},{"text":"core.ignoreCase","style":["code"],"link":null,"image":false},{"text":" matches across case.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"}
