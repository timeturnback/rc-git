{"kind":{"type":"paragraph"},"runs":[{"text":"Back returns to the list's current stop when the screen is not on it.","style":["strong"],"link":null,"image":false},{"text":" This would fix the empty-tab gap below. A stop that cannot be restored never matches the screen, though: the deleted-ref restore changes nothing (","style":[],"link":null,"image":false},{"text":"restoreTree","style":["code"],"link":null,"image":false},{"text":"). Each Back press would retry the same stop and the user could not get past it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":1}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Rewrite the current stop with where the restore ended.","style":["strong"],"link":null,"image":false},{"text":" The rewritten stop can equal its neighbor, and then one Back press changes nothing. ","style":[],"link":null,"image":false},{"text":"removeStops","style":["code"],"link":null,"image":false},{"text":" merges equal neighbors for the same reason. The list has no call that rewrites a stop; ","style":[],"link":null,"image":false},{"text":"stops","style":["code"],"link":null,"image":false},{"text":" is ","style":[],"link":null,"image":false},{"text":"private(set)","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":2}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Record from every model callback.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"select","style":["code"],"link":null,"image":false},{"text":" sets ","style":[],"link":null,"image":false},{"text":"selectedRef","style":["code"],"link":null,"image":false},{"text":" before its await, and ","style":[],"link":null,"image":false},{"text":"loadRoot","style":["code"],"link":null,"image":false},{"text":" closes the open file after it. A record in between is the new ref with the old file, a stop nobody was at.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":3}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Let restores overlap and drop the stale one with a generation check after each await.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"location.tree","style":["code"],"link":null,"image":false},{"text":" comes from ","style":[],"link":null,"image":false},{"text":"selectedRef","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"BrowserModel.location","style":["code"],"link":null,"image":false},{"text":"), which ","style":[],"link":null,"image":false},{"text":"select","style":["code"],"link":null,"image":false},{"text":" sets synchronously. A second restore into the same tree would find the tree already matching, skip the tree step of ","style":[],"link":null,"image":false},{"text":"move(to:)","style":["code"],"link":null,"image":false},{"text":", and resolve its file path in ","style":[],"link":null,"image":false},{"text":"openPath","style":["code"],"link":null,"image":false},{"text":" against the ","style":[],"link":null,"image":false},{"text":"rootTree","style":["code"],"link":null,"image":false},{"text":" the first restore has not replaced yet. Restores coalesce instead, with ","style":[],"link":null,"image":false},{"text":"isRestoring","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"pendingRestore","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"restore","style":["code"],"link":null,"image":false},{"text":", the shape ","style":[],"link":null,"image":false},{"text":"ChangesModel.loadStatus","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitKit/ChangesModel.swift","style":["code"],"link":null,"image":false},{"text":") uses for scans with ","style":[],"link":null,"image":false},{"text":"statusScanning","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"statusPending","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":4}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Accepted gap: a tab with no repository has no stop, since ","style":[],"link":null,"image":false},{"text":"currentStop","style":["code"],"link":null,"image":false},{"text":" is ","style":[],"link":null,"image":false},{"text":"nil","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"MainWindowController.currentStop","style":["code"],"link":null,"image":false},{"text":"). Coming to the front records nothing, and the list's mark stays on the tab the user left. Back pressed in the empty tab goes to the stop before that one.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
