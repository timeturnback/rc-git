{"kind":{"type":"heading","level":2},"runs":[{"text":"Context","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The back/forward feature keeps one ","style":[],"link":null,"image":false},{"text":"BackForwardList","style":["code"],"link":null,"image":false},{"text":" for the whole app, held by the one ","style":[],"link":null,"image":false},{"text":"Navigator","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitKit/Navigator.swift","style":["code"],"link":null,"image":false},{"text":") that ","style":[],"link":null,"image":false},{"text":"AppDelegate","style":["code"],"link":null,"image":false},{"text":" owns. A stop is a tab's repository path, its pane, and a ","style":[],"link":null,"image":false},{"text":"BrowserLocation","style":["code"],"link":null,"image":false},{"text":". The location names a tree, a file path, a history scope and a detail commit, and holds none of them (","style":[],"link":null,"image":false},{"text":"BrowsedTree","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"BrowserLocation","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitKit/BackForwardList.swift","style":["code"],"link":null,"image":false},{"text":"). ","style":[],"link":null,"image":false},{"text":"BrowserModel.restore","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitKit/BrowserModel.swift","style":["code"],"link":null,"image":false},{"text":") reads what the stop names from the repository as it is at that moment.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"So a restore can end somewhere other than its stop. A deleted ref reports an error and leaves the browser where it was (the ","style":[],"link":null,"image":false},{"text":".ref","style":["code"],"link":null,"image":false},{"text":" case of ","style":[],"link":null,"image":false},{"text":"restoreTree","style":["code"],"link":null,"image":false},{"text":"). A file that is no longer in the tree does not open (","style":[],"link":null,"image":false},{"text":"openPath","style":["code"],"link":null,"image":false},{"text":" answers other than ","style":[],"link":null,"image":false},{"text":".opened","style":["code"],"link":null,"image":false},{"text":"), and ","style":[],"link":null,"image":false},{"text":"restoreFile","style":["code"],"link":null,"image":false},{"text":" then empties the pane with ","style":[],"link":null,"image":false},{"text":"closeFile","style":["code"],"link":null,"image":false},{"text":", so the file of the stop left behind does not stay open under another stop's name. From then on the list's current stop and the screen disagree until the user moves.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"BackForwardList.visit","style":["code"],"link":null,"image":false},{"text":" ignores only a stop equal to the current one. Any other stop drops the stops ahead and is appended (","style":[],"link":null,"image":false},{"text":"BackForwardList.visit","style":["code"],"link":null,"image":false},{"text":"). While list and screen disagree, a call that records \"where the tab is\" counts as a move to a new place, and Forward is gone with the user having done nothing.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Guidance","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Record a stop only when something changed. Do not record to re-assert where the tab already is. The tree has three sources of a record:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The model's location changed.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"noteLocation","style":["code"],"link":null,"image":false},{"text":" compares ","style":[],"link":null,"image":false},{"text":"location","style":["code"],"link":null,"image":false},{"text":" with ","style":[],"link":null,"image":false},{"text":"reportedLocation","style":["code"],"link":null,"image":false},{"text":" and fires ","style":[],"link":null,"image":false},{"text":"onLocationChanged","style":["code"],"link":null,"image":false},{"text":" only on a difference, and only while no move is under way (","style":[],"link":null,"image":false},{"text":"BrowserModel.noteLocation","style":["code"],"link":null,"image":false},{"text":"). A method whose change spans an await brackets itself in ","style":[],"link":null,"image":false},{"text":"beginMove","style":["code"],"link":null,"image":false},{"text":"/","style":[],"link":null,"image":false},{"text":"endMove","style":["code"],"link":null,"image":false},{"text":", so it reports once, where it ended. The window controller turns the callback into ","style":[],"link":null,"image":false},{"text":"recordStop()","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"model.onLocationChanged","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"wireModel","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitApp/MainWindowController.swift","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"The user acted on the pane.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"switchMode","style":["code"],"link":null,"image":false},{"text":" is ","style":[],"link":null,"image":false},{"text":"setMode","style":["code"],"link":null,"image":false},{"text":" plus ","style":[],"link":null,"image":false},{"text":"recordStop()","style":["code"],"link":null,"image":false},{"text":", for a pane picked by itself (","style":[],"link":null,"image":false},{"text":"showFiles","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"showHistory","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"showChanges","style":["code"],"link":null,"image":false},{"text":"). An action that changes the pane on its way somewhere calls ","style":[],"link":null,"image":false},{"text":"setMode","style":["code"],"link":null,"image":false},{"text":", then the model, then ","style":[],"link":null,"image":false},{"text":"recordStop()","style":["code"],"link":null,"image":false},{"text":" when the call returns (","style":[],"link":null,"image":false},{"text":"browseWorkingTree","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"showHistory(ofPath:pathIsExact:)","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"openRepositoryLink","style":["code"],"link":null,"image":false},{"text":", and the ","style":[],"link":null,"image":false},{"text":"onBrowseCommit","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"onOpen","style":["code"],"link":null,"image":false},{"text":" closures set in ","style":[],"link":null,"image":false},{"text":"wireHistory","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"wireTree","style":["code"],"link":null,"image":false},{"text":"). When the model already reported the move, that last record equals the current stop and ","style":[],"link":null,"image":false},{"text":"visit","style":["code"],"link":null,"image":false},{"text":" drops it. It covers the case where the pane changed and the location did not.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Another tab came to the front.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"Navigator.tabCameToFront","style":["code"],"link":null,"image":false},{"text":" returns when the tab is already ","style":[],"link":null,"image":false},{"text":"front","style":["code"],"link":null,"image":false},{"text":", which is what the same window becoming main on app reactivation looks like. ","style":[],"link":null,"image":false},{"text":"AppDelegate.go","style":["code"],"link":null,"image":false},{"text":" calls ","style":[],"link":null,"image":false},{"text":"Navigator.beginRestore(in:)","style":["code"],"link":null,"image":false},{"text":", which sets ","style":[],"link":null,"image":false},{"text":"front","style":["code"],"link":null,"image":false},{"text":", before it shows the stop's window, so the tab switch a step makes is not recorded either.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Navigator.report","style":["code"],"link":null,"image":false},{"text":" then filters what arrives: nothing while ","style":[],"link":null,"image":false},{"text":"pendingRestores","style":["code"],"link":null,"image":false},{"text":" is non-zero, and nothing from a tab that is not in front. ","style":[],"link":null,"image":false},{"text":"AppDelegate","style":["code"],"link":null,"image":false},{"text":" only forwards tab events to it (","style":[],"link":null,"image":false},{"text":"onStop","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"onBecomeMain","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"onClose","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"AppDelegate.newWindow","style":["code"],"link":null,"image":false},{"text":"). A restore that moved the browser still ends with a model report, because ","style":[],"link":null,"image":false},{"text":"endMove","style":["code"],"link":null,"image":false},{"text":" runs in ","style":[],"link":null,"image":false},{"text":"restore","style":["code"],"link":null,"image":false},{"text":"'s ","style":[],"link":null,"image":false},{"text":"defer","style":["code"],"link":null,"image":false},{"text":". The app drops that report, and ","style":[],"link":null,"image":false},{"text":"reportedLocation","style":["code"],"link":null,"image":false},{"text":" now matches the screen, so a later ref refresh that moves nothing has no difference to report.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
