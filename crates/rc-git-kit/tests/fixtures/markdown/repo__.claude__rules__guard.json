{"kind":{"type":"paragraph"},"runs":[{"text":"A challenge with ","style":[],"link":null,"image":false},{"text":"backup_ref","style":["code"],"link":null,"image":false},{"text":" writes a ref under ","style":[],"link":null,"image":false},{"text":"refs/rc-git/backup/<kind>/<name>","style":["code"],"link":null,"image":false},{"text":" before the action runs. ","style":[],"link":null,"image":false},{"text":"<name>","style":["code"],"link":null,"image":false},{"text":" escapes ","style":[],"link":null,"image":false},{"text":"%","style":["code"],"link":null,"image":false},{"text":" as ","style":[],"link":null,"image":false},{"text":"%25","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"/","style":["code"],"link":null,"image":false},{"text":" as ","style":[],"link":null,"image":false},{"text":"%2F","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"-","style":["code"],"link":null,"image":false},{"text":" as ","style":[],"link":null,"image":false},{"text":"%2D","style":["code"],"link":null,"image":false},{"text":", so no backup nests under another or reads as another name's slot; a repeat takes one past the highest existing slot (","style":[],"link":null,"image":false},{"text":"-2","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"-3","style":["code"],"link":null,"image":false},{"text":", …, read once, not probed), so nothing is overwritten, and a slot of the same name already holding the object is reused. ","style":[],"link":null,"image":false},{"text":"Writer::write_backup_ref","style":["code"],"link":null,"image":false},{"text":" is that one implementation, gated on ","style":[],"link":null,"image":false},{"text":"Writer::backup_required","style":["code"],"link":null,"image":false},{"text":"; new destructive actions reuse it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Ref edits go through ","style":[],"link":null,"image":false},{"text":"Writer::apply_edit","style":["code"],"link":null,"image":false},{"text":" (synthetic ","style":[],"link":null,"image":false},{"text":"rc-git","style":["code"],"link":null,"image":false},{"text":" committer for the reflog). Object, index, working-tree and reflog writes live beside it on the ","style":[],"link":null,"image":false},{"text":"Writer","style":["code"],"link":null,"image":false},{"text":", each behind its own ","style":[],"link":null,"image":false},{"text":"#[expect(clippy::disallowed_methods, reason = ...)]","style":["code"],"link":null,"image":false},{"text":"; nothing outside the ","style":[],"link":null,"image":false},{"text":"actions","style":["code"],"link":null,"image":false},{"text":" module writes, and ","style":[],"link":null,"image":false},{"text":"scripts/check.sh","style":["code"],"link":null,"image":false},{"text":" fails on a write opt-out outside ","style":[],"link":null,"image":false},{"text":"actions/write.rs","style":["code"],"link":null,"image":false},{"text":". A new write is a new ","style":[],"link":null,"image":false},{"text":"Writer","style":["code"],"link":null,"image":false},{"text":" method.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Two hard rules live in the write path itself: never delete the checked-out branch, never create over an existing ref (","style":[],"link":null,"image":false},{"text":"PreviousValue::MustNotExist","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Anything that moves the working tree to another commit goes through ","style":[],"link":null,"image":false},{"text":"actions/treeapply.rs","style":["code"],"link":null,"image":false},{"text":": ","style":[],"link":null,"image":false},{"text":"plan","style":["code"],"link":null,"image":false},{"text":" the tree diff, ","style":[],"link":null,"image":false},{"text":"verify_clean","style":["code"],"link":null,"image":false},{"text":" every touched path (a dirty one refuses the whole operation by name, before a byte is written), ","style":[],"link":null,"image":false},{"text":"apply","style":["code"],"link":null,"image":false},{"text":", then move the ref ","style":[],"link":null,"image":false},{"text":"last","style":["emphasis"],"link":null,"image":false},{"text":". The fast-forward pull and the branch switch are both that sequence; a new one reuses it rather than walking a tree itself.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Pull stays fast-forward only: a divergence returns ","style":[],"link":null,"image":false},{"text":"ActionError::Diverged","style":["code"],"link":null,"image":false},{"text":" and the app hands the user a quoted ","style":[],"link":null,"image":false},{"text":"git pull --rebase","style":["code"],"link":null,"image":false},{"text":" for the checkout. Settle signing before adding anything that rewrites commits (rebase or merge pull, amend, squash): guard commits carry no signature and the user's signing config sits outside the isolated open (","style":[],"link":null,"image":false},{"text":"docs/solutions/architecture-patterns/fast-forward-only-pull-hands-divergence-to-git.md","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"A gix ref transaction writes no reflog for a symbolic update — it has no object id to log — and a direct branch edit logs only the branch, so checkout, commit and pull append their line to ","style":[],"link":null,"image":false},{"text":"logs/HEAD","style":["code"],"link":null,"image":false},{"text":" themselves through ","style":[],"link":null,"image":false},{"text":"Writer::open_head_reflog","style":["code"],"link":null,"image":false},{"text":" (before the first write) and ","style":[],"link":null,"image":false},{"text":"Writer::append_head_reflog","style":["code"],"link":null,"image":false},{"text":", only when the log already exists. Without it ","style":[],"link":null,"image":false},{"text":"git checkout -","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"HEAD@{1}","style":["code"],"link":null,"image":false},{"text":" would silently point at the wrong commit.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Protected patterns default to ","style":[],"link":null,"image":false},{"text":"main","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"master","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"release/*","style":["code"],"link":null,"image":false},{"text":", and are fixed: every caller uses ","style":[],"link":null,"image":false},{"text":"Policy::default()","style":["code"],"link":null,"image":false},{"text":" and no setting changes them yet.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
