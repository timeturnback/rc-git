{"kind":{"type":"paragraph"},"runs":[{"text":"Remote I/O lives in ","style":[],"link":null,"image":false},{"text":"actions/remote/","style":["code"],"link":null,"image":false},{"text":" only; the network entry points (","style":[],"link":null,"image":false},{"text":"find_remote","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"Remote::connect","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"handshake","style":["code"],"link":null,"image":false},{"text":", …) are clippy-banned everywhere else. HTTPS and SSH — ","style":[],"link":null,"image":false},{"text":"vet_remote_url","style":["code"],"link":null,"image":false},{"text":" routes the scheme, allowing plain http for loopback hosts so tests run end to end. The ssh transport (","style":[],"link":null,"image":false},{"text":"actions/remote/ssh/","style":["code"],"link":null,"image":false},{"text":") is in-process russh: ","style":[],"link":null,"image":false},{"text":"known_hosts","style":["code"],"link":null,"image":false},{"text":" is never written (approvals arrive as ","style":[],"link":null,"image":false},{"text":"RemoteAuth::accepted_hostkey","style":["code"],"link":null,"image":false},{"text":"), channel streams must drop inside the transport's runtime, and the passphrase rides ","style":[],"link":null,"image":false},{"text":"Credentials::token","style":["code"],"link":null,"image":false},{"text":". The key ladder in ","style":[],"link":null,"image":false},{"text":"ssh/auth.rs","style":["code"],"link":null,"image":false},{"text":" keeps OpenSSH's offer order and honors ","style":[],"link":null,"image":false},{"text":"IdentitiesOnly","style":["code"],"link":null,"image":false},{"text":": on GitHub the first accepted key picks the account (","style":[],"link":null,"image":false},{"text":"docs/solutions/integration-issues/ssh-auth-offers-wrong-agent-key-ignoring-identitiesonly.md","style":["code"],"link":null,"image":false},{"text":"). On the HTTPS side always install the credential closure; never let gix's helper cascade run (it spawns). Fetch and push take their HTTP options only from ","style":[],"link":null,"image":false},{"text":"http_options","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"actions/remote.rs","style":["code"],"link":null,"image":false},{"text":": repo-local ","style":[],"link":null,"image":false},{"text":"http.*","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"remote.<name>.proxy","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"credential.*","style":["code"],"link":null,"image":false},{"text":" keys are ignored, and a connection left without options would load them from config. ","style":[],"link":null,"image":false},{"text":"docs/solutions/architecture-patterns/hand-rolled-git-push-over-gix-https.md","style":["code"],"link":null,"image":false},{"text":" has the push recipe and its traps (","style":[],"link":null,"image":false},{"text":"prevent_pack_unload","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"MissingCommitter","style":["code"],"link":null,"image":false},{"text":", dev-only ","style":[],"link":null,"image":false},{"text":"http-client-insecure-credentials","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Resolve a branch's remote and tracking ref only through ","style":[],"link":null,"image":false},{"text":"configured_remote_name","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"tracking_ref_name","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"actions/remote.rs","style":["code"],"link":null,"image":false},{"text":", never gix's ","style":[],"link":null,"image":false},{"text":"branch_remote*","style":["code"],"link":null,"image":false},{"text":" helpers directly (clippy-banned in ","style":[],"link":null,"image":false},{"text":"clippy.toml","style":["code"],"link":null,"image":false},{"text":"; those two wrappers carry the only ","style":[],"link":null,"image":false},{"text":"#[expect]","style":["code"],"link":null,"image":false},{"text":"): those return ","style":[],"link":null,"image":false},{"text":"None","style":["code"],"link":null,"image":false},{"text":" for a branch with no ","style":[],"link":null,"image":false},{"text":"[branch]","style":["code"],"link":null,"image":false},{"text":" config and skip the ","style":[],"link":null,"image":false},{"text":"origin","style":["code"],"link":null,"image":false},{"text":" fallback, so status reads 0/0 while push still works. Test a new remote action on an ","style":[],"link":null,"image":false},{"text":"untrack","style":["code"],"link":null,"image":false},{"text":"ed clone (","style":[],"link":null,"image":false},{"text":"docs/solutions/integration-issues/tracking-ref-skips-origin-fallback-without-branch-merge.md","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"}
