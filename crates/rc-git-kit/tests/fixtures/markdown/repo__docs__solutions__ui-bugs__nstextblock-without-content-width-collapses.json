{"kind":{"type":"heading","level":2},"runs":[{"text":"Problem","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The markdown preview draws code panels, blockquote bars, and thematic rules by putting an ","style":[],"link":null,"image":false},{"text":"NSTextBlock","style":["code"],"link":null,"image":false},{"text":" in the paragraph style's ","style":[],"link":null,"image":false},{"text":"textBlocks","style":["code"],"link":null,"image":false},{"text":". Tables use ","style":[],"link":null,"image":false},{"text":"NSTextTableBlock","style":["code"],"link":null,"image":false},{"text":" the same way. Tables laid out correctly and everything else collapsed: a fenced code block rendered as a vertical column of single characters, one per line, down the whole pane.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Symptoms","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"A ","style":[],"link":null,"image":false},{"text":"NSLayoutManager","style":["code"],"link":null,"image":false},{"text":" measurement reproduces it without launching the app — lay the rendered string out in a 600-point ","style":[],"link":null,"image":false},{"text":"NSTextContainer","style":["code"],"link":null,"image":false},{"text":" and print ","style":[],"link":null,"image":false},{"text":"lineFragmentRect","style":["code"],"link":null,"image":false},{"text":" per fragment:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":null,"text":"w= 149.1 x=   0.0  Getting Started\\n\u000aw=  16.0 x=   8.0  # \u000aw=  16.0 x=   8.0  C\u000aw=  16.0 x=   8.0  l\u000aw=  16.0 x=   8.0  o\u000a...\u000aw=  97.9 x=   7.0  Package Mgr\\n      <- NSTextTableBlock, correct\u000aw=  62.1 x= 299.0  Bun 1.3\\n\u000aw= 588.5 x=   0.0  plain paragraph ...  <- no textBlocks, correct"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Every fragment inside a bare ","style":[],"link":null,"image":false},{"text":"NSTextBlock","style":["code"],"link":null,"image":false},{"text":" is 16 points wide — one monospaced glyph. Every fragment inside an ","style":[],"link":null,"image":false},{"text":"NSTextTableBlock","style":["code"],"link":null,"image":false},{"text":", and every fragment in a paragraph with no ","style":[],"link":null,"image":false},{"text":"textBlocks","style":["code"],"link":null,"image":false},{"text":" at all, uses the container's width as expected. The blockquote bar and the thematic rule hit the same thing; they are just less obvious, because a quote of short lines and a rule holding one newline both look plausible while collapsed.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"What Didn't Work","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Nothing about the container. ","style":[],"link":null,"image":false},{"text":"configureForPreview()","style":["code"],"link":null,"image":false},{"text":" already sets ","style":[],"link":null,"image":false},{"text":"widthTracksTextView = true","style":["code"],"link":null,"image":false},{"text":" and sizes the container to the scroll view, and the table in the same document proved the container was 600 points wide at the same moment the code block was","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The width the text got was decided per block, not per container.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":16}},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Solution","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Give every standalone block an explicit content width. In ","style":[],"link":null,"image":false},{"text":"mac/Sources/RcGitApp/MarkdownRenderer.swift","style":["code"],"link":null,"image":false},{"text":", one factory now builds all of them:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"swift","text":"static func fullWidthBlock() -> NSTextBlock {\u000a    let block = NSTextBlock()\u000a    block.setContentWidth(100, type: .percentageValueType)\u000a    return block\u000a}"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"quoteBlock()","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"panel(background:)","style":["code"],"link":null,"image":false},{"text":", and the thematic rule's block are built from it. A direct measurement of the four candidate fixes:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"table","alignments":["natural","trailing","natural"],"header":[[{"text":"block","style":[],"link":null,"image":false}],[{"text":"first fragment width","style":[],"link":null,"image":false}],[{"text":"fragments","style":[],"link":null,"image":false}]],"rows":[[[{"text":"bare ","style":[],"link":null,"image":false},{"text":"NSTextBlock","style":["code"],"link":null,"image":false}],[{"text":"16.0","style":[],"link":null,"image":false}],[{"text":"51","style":[],"link":null,"image":false}]],[[{"text":"setContentWidth(100, .percentageValueType)","style":["code"],"link":null,"image":false}],[{"text":"475.9","style":[],"link":null,"image":false}],[{"text":"1","style":[],"link":null,"image":false}]],[[{"text":"setValue(100, .percentageValueType, for: .width)","style":["code"],"link":null,"image":false}],[{"text":"475.9","style":[],"link":null,"image":false}],[{"text":"1","style":[],"link":null,"image":false}]],[[{"text":"setContentWidth(500, .absoluteValueType)","style":["code"],"link":null,"image":false}],[{"text":"475.9","style":[],"link":null,"image":false}],[{"text":"1","style":[],"link":null,"image":false}]],[[{"text":"one-column ","style":[],"link":null,"image":false},{"text":"NSTextTable","style":["code"],"link":null,"image":false}],[{"text":"475.9","style":[],"link":null,"image":false}],[{"text":"1","style":[],"link":null,"image":false}]]]},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The percentage content width is the one to use: it is the only option of the four that is both standalone and resolution-independent, so a nested quote takes 100% of its parent block and the panel follows the pane as the window resizes.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Why This Works","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"NSTextBlock","style":["code"],"link":null,"image":false},{"text":" has no intrinsic width. Inside an ","style":[],"link":null,"image":false},{"text":"NSTextTable","style":["code"],"link":null,"image":false},{"text":" the table's layout algorithm assigns each cell one, which is why ","style":[],"link":null,"image":false},{"text":"NSTextTableBlock","style":["code"],"link":null,"image":false},{"text":" never shows the bug and why the documented examples — all of them tables — never mention it. A block used on its own has nobody to assign it a width, and TextKit falls back to the minimum that fits a glyph. The API to say otherwise is ","style":[],"link":null,"image":false},{"text":"setContentWidth","style":["code"],"link":null,"image":false},{"text":", and a percentage resolves against the enclosing block or the container, so it stays correct under nesting and resizing.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Prevention","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Measure layout instead of launching the app: build ","style":[],"link":null,"image":false},{"text":"NSTextStorage","style":["code"],"link":null,"image":false},{"text":" + ","style":[],"link":null,"image":false},{"text":"NSLayoutManager","style":["code"],"link":null,"image":false},{"text":" + ","style":[],"link":null,"image":false},{"text":"NSTextContainer","style":["code"],"link":null,"image":false},{"text":" at a fixed width, ","style":[],"link":null,"image":false},{"text":"ensureLayout(for:)","style":["code"],"link":null,"image":false},{"text":", and walk ","style":[],"link":null,"image":false},{"text":"lineFragmentRect(forGlyphAt:effectiveRange:)","style":["code"],"link":null,"image":false},{"text":". A fragment far narrower than the container for text that should wrap is the signature of this bug, and the same harness checks a narrow container in the same run.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Rule going forward: any ","style":[],"link":null,"image":false},{"text":"NSTextBlock","style":["code"],"link":null,"image":false},{"text":" that is not an ","style":[],"link":null,"image":false},{"text":"NSTextTableBlock","style":["code"],"link":null,"image":false},{"text":" gets a content width at construction. Build them through one factory so a new block kind cannot be added without it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Both are enforced: ","style":[],"link":null,"image":false},{"text":"MarkdownRendererTests.standaloneBlocksFillThePane","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"mac/Tests/RcGitAppTests","style":["code"],"link":null,"image":false},{"text":") fails when any block's ","style":[],"link":null,"image":false},{"text":"lineFragmentRect","style":["code"],"link":null,"image":false},{"text":" is 100 points or narrower in a 600-point container, and the \"preview text blocks\" step of ","style":[],"link":null,"image":false},{"text":"scripts/check.sh","style":["code"],"link":null,"image":false},{"text":" fails when ","style":[],"link":null,"image":false},{"text":"mac/Sources","style":["code"],"link":null,"image":false},{"text":" holds any ","style":[],"link":null,"image":false},{"text":"NSTextBlock()","style":["code"],"link":null,"image":false},{"text":" besides the one in ","style":[],"link":null,"image":false},{"text":"fullWidthBlock()","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
