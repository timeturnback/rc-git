{"kind":{"type":"paragraph"},"runs":[{"text":"russh-config is a lightweight reimplementation of a well-specified format, and its API surface reads like it does more than it does: ","style":[],"link":null,"image":false},{"text":"Config::host_name","style":["code"],"link":null,"image":false},{"text":" looks like the resolved host but is the echo of the query. Rewriting the input into the subset the parser handles (single-space separators, lowercase patterns, explicit ","style":[],"link":null,"image":false},{"text":"Host *","style":["code"],"link":null,"image":false},{"text":" scope, includes spliced, ","style":[],"link":null,"image":false},{"text":"Match","style":["code"],"link":null,"image":false},{"text":" neutralized, first value kept) and reading the fields the parser actually fills (","style":[],"link":null,"image":false},{"text":"host_config","style":["code"],"link":null,"image":false},{"text":") resolves the directives rc-git consumes — ","style":[],"link":null,"image":false},{"text":"HostName","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"User","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"Port","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"IdentityFile","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"IdentitiesOnly","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"HostKeyAlias","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"IdentityAgent","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"UserKnownHostsFile","style":["code"],"link":null,"image":false},{"text":" — with URL values still winning where the URL specifies them.","style":[],"link":null,"image":false}],"quoteDept