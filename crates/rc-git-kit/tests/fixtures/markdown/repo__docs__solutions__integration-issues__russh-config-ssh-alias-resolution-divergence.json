{"kind":{"type":"paragraph"},"runs":[{"text":"Only a single space separates key and value.","style":["strong"],"link":null,"image":false},{"text":" The parser splits each line with ","style":[],"link":null,"image":false},{"text":"splitn(2, ' ')","style":["code"],"link":null,"image":false},{"text":": a legal ","style":[],"link":null,"image":false},{"text":"Key<TAB>value","style":["code"],"link":null,"image":false},{"text":" line yields one token and is dropped, ","style":[],"link":null,"image":false},{"text":"HostName=real.example","style":["code"],"link":null,"image":false},{"text":" is dropped, and ","style":[],"link":null,"image":false},{"text":"HostName = real.example","style":["code"],"link":null,"image":false},{"text":" resolves to ","style":[],"link":null,"image":false},{"text":"= real.example","style":["code"],"link":null,"image":false},{"text":". Fix: ","style":[],"link":null,"image":false},{"text":"split_directive","style":["code"],"link":null,"image":false},{"text":" splits the way OpenSSH does — whitespace with at most one ","style":[],"link":null,"image":false},{"text":"=","style":["code"],"link":null,"image":false},{"text":" — and writes ","style":[],"link":null,"image":false},{"text":"key value","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":3}},
