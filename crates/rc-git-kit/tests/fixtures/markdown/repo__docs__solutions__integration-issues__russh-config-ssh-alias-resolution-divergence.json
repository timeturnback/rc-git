{"kind":{"type":"paragraph"},"runs":[{"text":"Scalar directives overwrite within a block.","style":["strong"],"link":null,"image":false},{"text":" OpenSSH keeps the first value it obtains; russh-config keeps the last one within a block (it keeps the first across blocks). Fix: ","style":[],"link":null,"image":false},{"text":"ConfigReader::directive","style":["code"],"link":null,"image":false},{"text":" drops later duplicates of ","style":[],"link":null,"image":false},{"text":"User","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"HostName","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"Port","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"ProxyJump","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"ProxyCommand","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"UserKnownHostsFile","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"StrictHostKeyChecking","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"AddKeysToAgent","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"IdentitiesOnly","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"HostKeyAlias","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"IdentityAgent","style":["code"],"link":null,"image":false},{"text":"; ","style":[],"link":null,"image":false},{"text":"IdentityFile","style":["code"],"link":null,"image":false},{"text":" stays cumulative.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":7}},
