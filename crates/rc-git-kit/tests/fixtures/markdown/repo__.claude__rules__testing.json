{"kind":{"type":"paragraph"},"runs":[{"text":"Network tests use ","style":[],"link":null,"image":false},{"text":"HttpGitServer","style":["code"],"link":null,"image":false},{"text":" or ","style":[],"link":null,"image":false},{"text":"SshGitServer","style":["code"],"link":null,"image":false},{"text":" (testkit): serve a ","style":[],"link":null,"image":false},{"text":"git clone --bare","style":["code"],"link":null,"image":false},{"text":" copy placed in a ","style":[],"link":null,"image":false},{"text":"sibling","style":["strong"],"link":null,"image":false},{"text":" temp dir — a bare clone inside the origin's working tree gets swept into the next ","style":[],"link":null,"image":false},{"text":"git add -A","style":["code"],"link":null,"image":false},{"text":" commit and poisons the diff. Set ","style":[],"link":null,"image":false},{"text":"http.receivepack=true","style":["code"],"link":null,"image":false},{"text":" on the served repo or pushes 403. Basic-auth-over-http needs the dev-only ","style":[],"link":null,"image":false},{"text":"http-client-insecure-credentials","style":["code"],"link":null,"image":false},{"text":" gix-transport feature in the testing crate's dev-dependencies. rc-git-ffi tests never send credentials over http: ","style":[],"link":null,"image":false},{"text":"cargo test --workspace","style":["code"],"link":null,"image":false},{"text":" turns that feature on for them and ","style":[],"link":null,"image":false},{"text":"cargo test -p rc-git-ffi","style":["code"],"link":null,"image":false},{"text":" does not. Ssh tests clone from the local bare path, re-point ","style":[],"link":null,"image":false},{"text":"origin","style":["code"],"link":null,"image":false},{"text":" at ","style":[],"link":null,"image":false},{"text":"SshGitServer::url()","style":["code"],"link":null,"image":false},{"text":", and pass a fixture directory via ","style":[],"link":null,"image":false},{"text":"RemoteAuth::ssh_dir","style":["code"],"link":null,"image":false},{"text":" (CLI: ","style":[],"link":null,"image":false},{"text":"--ssh-dir","style":["code"],"link":null,"image":false},{"text":") — never the developer's real ","style":[],"link":null,"image":false},{"text":"~/.ssh","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"}
