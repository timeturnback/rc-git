{"kind":{"type":"paragraph"},"runs":[{"text":"Assert against ","style":[],"link":null,"image":false},{"text":"git rev-parse","style":["code"],"link":null,"image":false},{"text":", not hard-coded hashes, so a fixture change does not rewrite every expectation.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Test behavior through the public API. A refactor that keeps behavior must not break a test.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
