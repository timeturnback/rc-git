{"kind":{"type":"paragraph"},"runs":[{"text":"Unit tests may ","style":[],"link":null,"image":false},{"text":"unwrap","style":["code"],"link":null,"image":false},{"text":"; library code may not. Integration test files carry ","style":[],"link":null,"image":false},{"text":"#![expect(clippy::unwrap_used, ...)]","style":["code"],"link":null,"image":false},{"text":" only when a helper ","style":[],"link":null,"image":false},{"text":"outside","style":["emphasis"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"#[test]","style":["code"],"link":null,"image":false},{"text":" fns unwraps — ","style":[],"link":null,"image":false},{"text":"allow-unwrap-in-tests","style":["code"],"link":null,"image":false},{"text":" in ","style":[],"link":null,"image":false},{"text":"clippy.toml","style":["code"],"link":null,"image":false},{"text":" already covers ","style":[],"link":null,"image":false},{"text":"#[test]","style":["code"],"link":null,"image":false},{"text":" bodies, so the expect is otherwise unfulfilled and fails ","style":[],"link":null,"image":false},{"text":"-D warnings","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
