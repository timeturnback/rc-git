{"kind":{"type":"paragraph"},"runs":[{"text":"Anything that differs between the installed app and the dev bundle reads ","style":[],"link":null,"image":false},{"text":"AppBuild","style":["code"],"link":null,"image":false},{"text":" (variant, source checkout, commit, ","style":[],"link":null,"image":false},{"text":"updateMode","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"relaunchPath","style":["code"],"link":null,"image":false},{"text":"); never test the bundle identifier by hand. Work the updater does outside the process — toolchain probe, checkout read, pull, build, relaunch — goes behind ","style":[],"link":null,"image":false},{"text":"UpdateEnvironment","style":["code"],"link":null,"image":false},{"text":" so ","style":[],"link":null,"image":false},{"text":"UpdateModel","style":["code"],"link":null,"image":false},{"text":" stays testable.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
