{"kind":{"type":"paragraph"},"runs":[{"text":"The exception unwound into AppKit's launch Apple Event processing (","style":[],"link":null,"image":false},{"text":"aeProcessAppleEvent","style":["code"],"link":null,"image":false},{"text":" → ","style":[],"link":null,"image":false},{"text":"_NSAppleEventManagerGenericHandler","style":["code"],"link":null,"image":false},{"text":"), where ","style":[],"link":null,"image":false},{"text":"AppKit swallows it silently","style":["strong"],"link":null,"image":false},{"text":" — nothing on stderr, nothing in the unified log. ","style":[],"link":null,"image":false},{"text":"applicationDidFinishLaunching","style":["code"],"link":null,"image":false},{"text":" aborted before reaching ","style":[],"link":null,"image":false},{"text":"showWindow(nil)","style":["code"],"link":null,"image":false},{"text":", so the windows existed in the window server (created with ","style":[],"link":null,"image":false},{"text":"defer: false","style":["code"],"link":null,"image":false},{"text":") but were never ordered in. The event loop then ran normally: a healthy-looking, windowless app.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":5}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Reordering ","style":[],"link":null,"image":false},{"text":"init","style":["code"],"link":null,"image":false},{"text":" makes the split view items exist before any resize can fire ","style":[],"link":null,"image":false},{"text":"applyLayout","style":["code"],"link":null,"image":false},{"text":"; the ","style":[],"link":null,"image":false},{"text":".first","style":["code"],"link":null,"image":false},{"text":" guard makes the callback safe even if a future change reintroduces an early resize. This also explains the reproduction pattern: with no saved frame (first run) the restore does not resize, so nothing fires — every run after a frame was saved crashed.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
