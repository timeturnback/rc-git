{"kind":{"type":"paragraph"},"runs":[{"text":"defaults write <bundle-id> NSApplicationCrashOnExceptions -bool true","style":["code"],"link":null,"image":false},{"text":", relaunch. The swallowed exception becomes a real crash; the ","style":[],"link":null,"image":false},{"text":".ips","style":["code"],"link":null,"image":false},{"text":" report's ","style":[],"link":null,"image":false},{"text":"asiBacktraces","style":["code"],"link":null,"image":false},{"text":" holds the original throw site with symbols (here: ","style":[],"link":null,"image":false},{"text":"applyLayout","style":["code"],"link":null,"image":false},{"text":" ← ","style":[],"link":null,"image":false},{"text":"windowDidResize","style":["code"],"link":null,"image":false},{"text":" ← ","style":[],"link":null,"image":false},{"text":"_setFrameCommon","style":["code"],"link":null,"image":false},{"text":" ← ","style":[],"link":null,"image":false},{"text":"_setFrameAutosaveName:","style":["code"],"link":null,"image":false},{"text":" ← ","style":[],"link":null,"image":false},{"text":"MainWindowController.init","style":["code"],"link":null,"image":false},{"text":" ← ","style":[],"link":null,"image":false},{"text":"applicationDidFinishLaunching","style":["code"],"link":null,"image":false},{"text":").","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":2}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Delete the default after diagnosis.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":3}},
{"kind":{"type":"paragraph"},"runs":[{"text":"CGWindowListCopyWindowInfo","style":["code"],"link":null,"image":false},{"text":" with ","style":[],"link":null,"image":false},{"text":".optionAll","style":["code"],"link":null,"image":false},{"text":" distinguishes \"window never created\" from \"created but never ordered in\" (","style":[],"link":null,"image":false},{"text":"kCGWindowIsOnscreen","style":["code"],"link":null,"image":false},{"text":") from \"ordered in off-screen\" (bounds).","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":4}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Code rules:","style":["strong"],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Never set a window/view delegate before the state its callbacks touch exists. ","style":[],"link":null,"image":false},{"text":"windowDidResize","style":["code"],"link":null,"image":false},{"text":" can fire inside ","style":[],"link":null,"image":false},{"text":"init","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Treat a frame restore — ","style":[],"link":null,"image":false},{"text":"setFrameUsingName(_:)","style":["code"],"link":null,"image":false},{"text":", which ","style":[],"link":null,"image":false},{"text":"MainWindowController.init()","style":["code"],"link":null,"image":false},{"text":" calls, or ","style":[],"link":null,"image":false},{"text":"setFrameAutosaveName(_:)","style":["code"],"link":null,"image":false},{"text":" when a frame is saved under that name — as an immediate ","style":[],"link":null,"image":false},{"text":"windowDidResize","style":["code"],"link":null,"image":false},{"text":" source, not passive bookkeeping: it restores (and resizes) at the call site.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
