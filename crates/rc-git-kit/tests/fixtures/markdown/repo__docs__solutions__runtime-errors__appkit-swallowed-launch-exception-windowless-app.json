{"kind":{"type":"paragraph"},"runs":[{"text":"After (","style":[],"link":null,"image":false},{"text":"MainWindowController.init()","style":["code"],"link":null,"image":false},{"text":", as it reads today) — views exist before anything can resize the window. The restore has since moved from ","style":[],"link":null,"image":false},{"text":"setFrameAutosaveName","style":["code"],"link":null,"image":false},{"text":" to ","style":[],"link":null,"image":false},{"text":"setFrameUsingName(Self.frameName)","style":["code"],"link":null,"image":false},{"text":", because AppKit grants an autosave name to one live window only and every tab is its own window; it resizes the window the same way:","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"swift","text":"super.init(window: window)\u000awindow.delegate = self\u000a// Views must exist before the frame restore below: restoring resizes the window,\u000a// which fires windowDidResize and runs applyLayout.\u000abuildSplitViews()\u000abuildToolbar()\u000abuildVersionBadge()\u000awireModel()\u000a// ...wireRefs(), wireHistory(), wireTree(), wireFile(), renderBanner()\u000awindow.center()\u000a_ = window.setFrameUsingName(Self.frameName)\u000a// A frame saved on a display that is now detached restores fully off-screen.\u000aif !NSScreen.screens.contains(where: { $0.visibleFrame.intersects(window.frame) }) {\u000a    window.center()\u000a}\u000aapplyLayout()"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
