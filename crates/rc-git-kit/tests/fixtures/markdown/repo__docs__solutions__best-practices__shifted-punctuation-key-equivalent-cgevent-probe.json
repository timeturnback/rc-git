{"kind":{"type":"paragraph"},"runs":[{"text":"Define shifted punctuation as the unshifted key plus ","style":["strong"],"link":null,"image":false},{"text":".shift","style":["strong","code"],"link":null,"image":false},{"text":" in the mask.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"\".\"","style":["code"],"link":null,"image":false},{"text":" with ","style":[],"link":null,"image":false},{"text":"[.command, .shift]","style":["code"],"link":null,"image":false},{"text":" catches ⇧⌘., the keystroke Finder uses for the same toggle, and the menu shows it as ⇧⌘.. Letters work either way, uppercase alone or lowercase plus ","style":[],"link":null,"image":false},{"text":".shift","style":["code"],"link":null,"image":false},{"text":". Punctuation has no uppercase form, so the unshifted key plus ","style":[],"link":null,"image":false},{"text":".shift","style":["code"],"link":null,"image":false},{"text":" is its only form that shows the shortcut as the user types it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Test key-equivalent matching with a layout-derived event, never a hand-built one.","style":["strong"],"link":null,"image":false},{"text":" Build the event from ","style":[],"link":null,"image":false},{"text":"CGEvent(keyboardEventSource:virtualKey:keyDown:)","style":["code"],"link":null,"image":false},{"text":" and wrap it with ","style":[],"link":null,"image":false},{"text":"NSEvent(cgEvent:)","style":["code"],"link":null,"image":false},{"text":". The current keyboard layout then fills in ","style":[],"link":null,"image":false},{"text":"characters","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"charactersIgnoringModifiers","style":["code"],"link":null,"image":false},{"text":" the way a real keystroke does, and the event carries what else AppKit matches on.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"Answer it headless.","style":["strong"],"link":null,"image":false},{"text":" A script compiled with ","style":[],"link":null,"image":false},{"text":"xcrun swiftc","style":["code"],"link":null,"image":false},{"text":" that touches ","style":[],"link":null,"image":false},{"text":"NSApplication.shared","style":["code"],"link":null,"image":false},{"text":", builds an ","style":[],"link":null,"image":false},{"text":"NSMenu","style":["code"],"link":null,"image":false},{"text":" of items with a ","style":[],"link":null,"image":false},{"text":"target","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"action","style":["code"],"link":null,"image":false},{"text":", and calls ","style":[],"link":null,"image":false},{"text":"performKeyEquivalent(with:)","style":["code"],"link":null,"image":false},{"text":" runs in seconds. Put the candidate definitions in one menu and also one at a time, and test the neighbouring shortcut to rule out a collision.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
