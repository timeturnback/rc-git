{"kind":{"type":"paragraph"},"runs":[{"text":"Two sites opt out with a reason: the reflog append above (","style":[],"link":null,"image":false},{"text":"checkout.rs:183-186","style":["code"],"link":null,"image":false},{"text":") and the test kit's ","style":[],"link":null,"image":false},{"text":"known_hosts","style":["code"],"link":null,"image":false},{"text":" appender (","style":[],"link":null,"image":false},{"text":"crates/rc-git-testkit/src/ssh.rs:179-192","style":["code"],"link":null,"image":false},{"text":"), which had been using ","style":[],"link":null,"image":false},{"text":"OpenOptions","style":["code"],"link":null,"image":false},{"text":" unnoticed until the ban named it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
