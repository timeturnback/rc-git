{"kind":{"type":"paragraph"},"runs":[{"text":"Separately: ","style":[],"link":null,"image":false},{"text":"clippy.toml","style":["code"],"link":null,"image":false},{"text":" bans every other write API in the workspace, yet ","style":[],"link":null,"image":false},{"text":"std::fs::OpenOptions::new().append(true).open(..)","style":["code"],"link":null,"image":false},{"text":" — added for the reflog append — drew no warning at all. The lint was green on a new write door.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
