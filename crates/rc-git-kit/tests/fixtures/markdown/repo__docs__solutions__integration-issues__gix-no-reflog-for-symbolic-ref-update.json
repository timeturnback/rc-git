{"kind":{"type":"paragraph"},"runs":[{"text":"The ref edit alone, which looks right.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"point_head_at","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/checkout.rs:113","style":["code"],"link":null,"image":false},{"text":") builds the edit the way every other rc-git ref write does, through the same ","style":[],"link":null,"image":false},{"text":"apply_edit","style":["code"],"link":null,"image":false},{"text":" funnel: an expectation that ","style":[],"link":null,"image":false},{"text":"HEAD","style":["code"],"link":null,"image":false},{"text":" still holds what the switch was planned against (","style":[],"link":null,"image":false},{"text":"checkout.rs:119-123","style":["code"],"link":null,"image":false},{"text":"), then ","style":[],"link":null,"image":false},{"text":"RefLog::AndReference","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"force_create_reflog: false","style":["code"],"link":null,"image":false},{"text":", and a message (","style":[],"link":null,"image":false},{"text":"checkout.rs:127-129","style":["code"],"link":null,"image":false},{"text":"). It returns ","style":[],"link":null,"image":false},{"text":"Ok","style":["code"],"link":null,"image":false},{"text":", writes ","style":[],"link":null,"image":false},{"text":".git/HEAD","style":["code"],"link":null,"image":false},{"text":", and logs nothing. There is no error, no warning, and no field on ","style":[],"link":null,"image":false},{"text":"LogChange","style":["code"],"link":null,"image":false},{"text":" left unset.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Calling gix's own reflog writer.","style":["strong"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"file::Store::reflog_create_or_append","style":["code"],"link":null,"image":false},{"text":" is ","style":[],"link":null,"image":false},{"text":"pub(crate)","style":["code"],"link":null,"image":false},{"text":" (","style":[],"link":null,"image":false},{"text":"gix-ref-0.67.1/src/store/file/loose/reflog.rs:100","style":["code"],"link":null,"image":false},{"text":"), so the function the transaction itself would have called is unreachable from a downstream crate.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Looking for a public gix API that logs a symref update.","style":["strong"],"link":null,"image":false},{"text":" There is none in gix ","style":[],"link":null,"image":false},{"text":"=0.87.1","style":["code"],"link":null,"image":false},{"text":". The behavior is deliberate and unconditional except for one shape (see ","style":[],"link":null,"image":false},{"text":"Why This Works","style":["emphasis"],"link":null,"image":false},{"text":"), and no option on the edit turns it on — ","style":[],"link":null,"image":false},{"text":"force_create_reflog","style":["code"],"link":null,"image":false},{"text":" governs whether a ","style":[],"link":null,"image":false},{"text":"missing","style":["emphasis"],"link":null,"image":false},{"text":" log file is created, not whether a symbolic update is logged.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Solution","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Append the line by hand, using gix's own serializer, and only when the log already exists (","style":[],"link":null,"image":false},{"text":"log_head_switch","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"crates/rc-git-guard/src/actions/checkout.rs:159","style":["code"],"link":null,"image":false},{"text":"):","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"rust","text":"let path = repo.git_dir().join(\"logs\").join(\"HEAD\");\u000aif !path.exists() {\u000a    return Ok(());\u000a}\u000alet line = gix::refs::log::Line {\u000a    previous_oid: old.unwrap_or_else(|| ObjectId::null(repo.object_hash())),\u000a    new_oid: new,\u000a    signature: gix::actor::Signature {\u000a        name: \"rc-git\".into(),\u000a        email: \"rc-git@localhost\".into(),\u000a        time: gix::date::Time::now_local_or_utc(),\u000a    },\u000a    message: format!(\"checkout: moving from {from} to {to}\").into(),\u000a};\u000alet mut serialized = Vec::new();\u000aline.write_to(&mut serialized)\u000a    .map_err(|source| reflog_error(Box::new(source)))?;\u000a#[expect(\u000a    clippy::disallowed_methods,\u000a    reason = \"the guard crate is the one sanctioned write path; see docs/safety.md\"\u000a)]\u000a{\u000a    use std::io::Write;\u000a    let mut file = std::fs::OpenOptions::new()\u000a        .append(true)\u000a        .open(&path)\u000a        .map_err(|source| reflog_error(Box::new(source)))?;\u000a    file.write_all(&serialized)\u000a        .map_err(|source| reflog_error(Box::new(source)))?;\u000a}"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"from","style":["code"],"link":null,"image":false},{"text":" is the previous branch's short name, or the full id of the commit ","style":[],"link":null,"image":false},{"text":"HEAD","style":["code"],"link":null,"image":false},{"text":" was detached at, which is what ","style":[],"link":null,"image":false},{"text":"git checkout -","style":["code"],"link":null,"image":false},{"text":" parses (","style":[],"link":null,"image":false},{"text":"checkout.rs:71-75","style":["code"],"link":null,"image":false},{"text":"). An unborn branch still has a name, so it is logged by that name with a null old id; a ","style":[],"link":null,"image":false},{"text":"HEAD","style":["code"],"link":null,"image":false},{"text":" that names no branch and resolves to no commit is refused before anything is written. The append runs after the ref edit (","style":[],"link":null,"image":false},{"text":"checkout.rs:83-87","style":["code"],"link":null,"image":false},{"text":"); if it fails, the error names ","style":[],"link":null,"image":false},{"text":"logs/HEAD","style":["code"],"link":null,"image":false},{"text":", so a half-done switch is legible rather than silent.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
