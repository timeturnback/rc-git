{"kind":{"type":"paragraph"},"runs":[{"text":"rc-git's first branch switch moved ","style":[],"link":null,"image":false},{"text":"HEAD","style":["code"],"link":null,"image":false},{"text":" with a normal gix ref transaction — ","style":[],"link":null,"image":false},{"text":"Target::Symbolic(\"refs/heads/<branch>\")","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"RefLog::AndReference","style":["code"],"link":null,"image":false},{"text":" — and the transaction returned ","style":[],"link":null,"image":false},{"text":"Ok","style":["code"],"link":null,"image":false},{"text":" while writing nothing to ","style":[],"link":null,"image":false},{"text":".git/logs/HEAD","style":["code"],"link":null,"image":false},{"text":". Every switch therefore left ","style":[],"link":null,"image":false},{"text":"git checkout -","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"HEAD@{n}","style":["code"],"link":null,"image":false},{"text":" naming the wrong commit, with no error anywhere to say so.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Symptoms","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":".git/HEAD","style":["code"],"link":null,"image":false},{"text":" is correct (","style":[],"link":null,"image":false},{"text":"ref: refs/heads/feature","style":["code"],"link":null,"image":false},{"text":"), the working tree and index are correct, ","style":[],"link":null,"image":false},{"text":"git status --porcelain","style":["code"],"link":null,"image":false},{"text":" is empty, and ","style":[],"link":null,"image":false},{"text":"edit_references_as","style":["code"],"link":null,"image":false},{"text":" returned ","style":[],"link":null,"image":false},{"text":"Ok","style":["code"],"link":null,"image":false},{"text":" — nothing reports a failure.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
{"kind":{"type":"paragraph"},"runs":[{"text":"git reflog show --format=%gs -1 HEAD","style":["code"],"link":null,"image":false},{"text":" still shows the ","style":[],"link":null,"image":false},{"text":"previous","style":["emphasis"],"link":null,"image":false},{"text":" entry, a ","style":[],"link":null,"image":false},{"text":"commit:","style":["code"],"link":null,"image":false},{"text":" line. The switch is absent from the log entirely, not malformed in it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":"bullet"},
