{"kind":{"type":"code","language":"sh","text":"rustup toolchain install   # the version pinned in rust-toolchain.toml\u000acargo install cbindgen --version 0.29.4 --locked   # brew cannot pin it\u000abrew install cargo-deny prek shellcheck shfmt actionlint zizmor\u000axcode-select --install     # or Xcode 27+; swift-format ships with it\u000ascripts/build.sh           # Rust lib, header, Swift package"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Git hooks run through the global ","style":[],"link":null,"image":false},{"text":"core.hooksPath","style":["code"],"link":null,"image":false},{"text":" dispatcher, which invokes ","style":[],"link":null,"image":false},{"text":"prek","style":["code"],"link":null,"image":false},{"text":" whenever a repository has ","style":[],"link":null,"image":false},{"text":".pre-commit-config.yaml","style":["code"],"link":null,"image":false},{"text":"; with it there is no per-repository install step. Without a global dispatcher, run ","style":[],"link":null,"image":false},{"text":"prek install","style":["code"],"link":null,"image":false},{"text":" once per clone; never run it where a global ","style":[],"link":null,"image":false},{"text":"core.hooksPath","style":["code"],"link":null,"image":false},{"text":" already owns the hook slot (prek refuses there anyway).","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Daily loop","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"sh","text":"cargo test --workspace                      # after Rust changes\u000ascripts/gen-header.sh                       # after changing rc-git-ffi\u000aswift test --package-path mac               # after Swift changes\u000ascripts/check.sh --fast                     # everything except the Swift half\u000ascripts/check.sh                            # CI's checks; CI also runs build-app.sh"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"rust-toolchain.toml","style":["code"],"link":null,"image":false},{"text":" pins Rust (with clippy and rustfmt), and ","style":[],"link":null,"image":false},{"text":"scripts/gen-header.sh","style":["code"],"link":null,"image":false},{"text":" and CI pin cbindgen 0.29.4, so a new release cannot change the gate's verdict on its own. When another cbindgen produces a different header, ","style":[],"link":null,"image":false},{"text":"gen-header.sh","style":["code"],"link":null,"image":false},{"text":" names both versions and leaves the header alone. Bump either on purpose, in its own commit, and fix what the new lints or header formatting report in the same change.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"swift build","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"swift test","style":["code"],"link":null,"image":false},{"text":" link ","style":[],"link":null,"image":false},{"text":"target/app/librc_git_ffi.a","style":["code"],"link":null,"image":false},{"text":"; rebuild it with ","style":[],"link":null,"image":false},{"text":"scripts/rust-lib.sh release","style":["code"],"link":null,"image":false},{"text":" (or ","style":[],"link":null,"image":false},{"text":"debug","style":["code"],"link":null,"image":false},{"text":", the faster ","style":[],"link":null,"image":false},{"text":"app-dev","style":["code"],"link":null,"image":false},{"text":" profile without LTO) whenever the Rust side changes. A plain ","style":[],"link":null,"image":false},{"text":"cargo build -p rc-git-ffi","style":["code"],"link":null,"image":false},{"text":" does not update that copy.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Running the app","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"There are two bundles, and they are meant to run side by side.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"code","language":"sh","text":"scripts/install-app.sh             # release: builds, installs /Applications/RCGit.app\u000ascripts/build-app.sh --dev         # dev: builds RCGit-dev.app in the checkout\u000aopen RCGit-dev.app                 # or: open -a RCGit ~/code/repo for the release app\u000amac/.build/debug/RcGitApp ~/code/repo      # without a bundle"},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Build the dev bundle from the terminal once; after that ⌥⌘R inside it rebuilds and relaunches without losing tabs (the app menu's Rebuild and Relaunch… opens the Rebuild window first; see below).","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"table","alignments":["natural","natural","natural"],"header":[[],[{"text":"release","style":[],"link":null,"image":false}],[{"text":"dev","style":[],"link":null,"image":false}]],"rows":[[[{"text":"Bundle","style":[],"link":null,"image":false}],[{"text":"/Applications/RCGit.app","style":["code"],"link":null,"image":false}],[{"text":"<checkout>/RCGit-dev.app","style":["code"],"link":null,"image":false}]],[[{"text":"Identifier","style":[],"link":null,"image":false}],[{"text":"com.timeturnback.rcgit","style":["code"],"link":null,"image":false}],[{"text":"com.timeturnback.rcgit.dev","style":["code"],"link":null,"image":false}]],[[{"text":"Name","style":[],"link":null,"image":false}],[{"text":"rc-git","style":[],"link":null,"image":false}],[{"text":"rc-git (dev)","style":[],"link":null,"image":false}]],[[{"text":"Icon","style":[],"link":null,"image":false}],[{"text":"blue commit graph","style":[],"link":null,"image":false}],[{"text":"orange, striped","style":[],"link":null,"image":false}]],[[{"text":"Swift config","style":[],"link":null,"image":false}],[{"text":"release","style":[],"link":null,"image":false}],[{"text":"debug","style":[],"link":null,"image":false}]]]},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The identifier is what separates them: tabs, recents, window frames, and trusted ssh host key fingerprints live in ","style":[],"link":null,"image":false},{"text":"UserDefaults","style":["code"],"link":null,"image":false},{"text":" under it, so testing in dev never disturbs the tabs the release app has open. Keychain items are per host, not per app, so both ask for a remote's secret the first time each new code identity uses it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Icons come from ","style":[],"link":null,"image":false},{"text":"scripts/make-icon.swift","style":["code"],"link":null,"image":false},{"text":" — a commit-graph mark drawn with Core Graphics — cached in ","style":[],"link":null,"image":false},{"text":"build/icons/","style":["code"],"link":null,"image":false},{"text":" and regenerated whenever that script is newer.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Agents do not launch the app; see the working agreement in ","style":[],"link":null,"image":false},{"text":"CLAUDE.md","style":["code"],"link":null,"image":false},{"text":". Reproduce with the CLI: ","style":[],"link":null,"image":false},{"text":"cargo run -p rc-git-cli -- --time ls <repo>","style":["code"],"link":null,"image":false},{"text":".","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Rebuilding from inside the app","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Both bundles are stamped with the checkout and commit they were built from, and both have an app-menu item that rebuilds themselves from there. They differ in what they build.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Release — \"Update rc-git\":","style":["strong"],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Preflight.","style":["strong"],"link":null,"image":false},{"text":" The login shell must find ","style":[],"link":null,"image":false},{"text":"cargo","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"swift","style":["code"],"link":null,"image":false},{"text":", and ","style":[],"link":null,"image":false},{"text":"cbindgen","style":["code"],"link":null,"image":false},{"text":", and the checkout must have no uncommitted tracked changes. The log names each half before it runs, and the toolchain probe is killed after 20 seconds: a login shell that hangs fails the update with what to run in a terminal instead of spinning forever.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":1}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Fetch and fast-forward","style":["strong"],"link":null,"image":false},{"text":" through ","style":[],"link":null,"image":false},{"text":"rc-git-guard","style":["code"],"link":null,"image":false},{"text":", exactly like the Changes tab's Pull — same credential prompts, same refusal when the branch has diverged.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":2}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Build and install","style":["strong"],"link":null,"image":false},{"text":" by running ","style":[],"link":null,"image":false},{"text":"scripts/install-app.sh","style":["code"],"link":null,"image":false},{"text":", with its output streaming into the window. Nothing is skipped: it is the same script you would run by hand.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":3}},
{"kind":{"type":"paragraph"},"runs":[{"text":"Relaunch.","style":["strong"],"link":null,"image":false},{"text":" Tabs are saved, the new bundle is launched, and this one quits. The bundle identifier does not change, so the new instance reopens the same tabs.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":1,"marker":{"ordered":4}},
{"kind":{"type":"paragraph"},"runs":[{"text":"When the checkout is already at the commit the running bundle was built from, the window says so and the button becomes \"Rebuild Anyway\" rather than spending minutes on a rebuild.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"Dev — \"Rebuild and Relaunch…\" (opens the window; ⌥⌘R, \"Rebuild and Relaunch Now\", starts it without the button):","style":["strong"],"link":null,"image":false},{"text":" preflight, then ","style":[],"link":null,"image":false},{"text":"scripts/build-app.sh --dev","style":["code"],"link":null,"image":false},{"text":", then relaunch. No fetch, no network, no credentials, and no dirty check — it builds the working tree exactly as it stands, because putting work in progress into the running app is the point. It never reports \"up to date\": the tree moves without the commit. The log names the tracked files with uncommitted changes; new untracked files are built too but not listed.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"That is the edit-run loop: edit, ⌥⌘R, look. Tabs come back on the other side because they live in ","style":[],"link":null,"image":false},{"text":"UserDefaults","style":["code"],"link":null,"image":false},{"text":" under a bundle identifier the rebuild does not change — though only the open repositories and the selected tab are restored, not what each tab was showing.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"scripts/build-app.sh","style":["code"],"link":null,"image":false},{"text":" assembles into ","style":[],"link":null,"image":false},{"text":"build/stage/","style":["code"],"link":null,"image":false},{"text":" and swaps at the end. The dev bundle runs that script to replace itself, and a bundle deleted out from under a live process loses every resource it has not already loaded.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"The app is ad-hoc signed, so every rebuild is a new code identity and the login keychain re-prompts for each remote host's stored token (\"Always Allow\" makes it once per rebuild). A stable signing identity in ","style":[],"link":null,"image":false},{"text":"scripts/build-app.sh","style":["code"],"link":null,"image":false},{"text":" is the real fix; until then the prompt churn is expected during development.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Lint configuration","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"table","alignments":["natural","natural"],"header":[[{"text":"File","style":[],"link":null,"image":false}],[{"text":"Governs","style":[],"link":null,"image":false}]],"rows":[[[{"text":"Cargo.toml","style":["code"],"link":null,"image":false},{"text":" ","style":[],"link":null,"image":false},{"text":"[workspace.lints]","style":["code"],"link":null,"image":false}],[{"text":"rustc and clippy levels for all crates but rc-git-ffi and rc-git-testkit, whose hand copies ","style":[],"link":null,"image":false},{"text":"scripts/check.sh","style":["code"],"link":null,"image":false},{"text":" diffs against it","style":[],"link":null,"image":false}]],[[{"text":"clippy.toml","style":["code"],"link":null,"image":false}],[{"text":"banned write APIs, test allowances","style":[],"link":null,"image":false}]],[[{"text":"rustfmt.toml","style":["code"],"link":null,"image":false}],[{"text":"100 columns, 2024 edition style","style":[],"link":null,"image":false}]],[[{"text":"deny.toml","style":["code"],"link":null,"image":false}],[{"text":"advisories, license allowlist, sources","style":[],"link":null,"image":false}]],[[{"text":".swift-format","style":["code"],"link":null,"image":false}],[{"text":"100 columns, 4-space indent, ordered imports","style":[],"link":null,"image":false}]],[[{"text":".editorconfig","style":["code"],"link":null,"image":false}],[{"text":"2-space shell and YAML, so ","style":[],"link":null,"image":false},{"text":"shfmt","style":["code"],"link":null,"image":false},{"text":" agrees with the editor","style":[],"link":null,"image":false}]],[[{"text":".pre-commit-config.yaml","style":["code"],"link":null,"image":false}],[{"text":"what runs before each commit","style":[],"link":null,"image":false}]]]},"runs":[],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"heading","level":2},"runs":[{"text":"Continuous integration","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":".github/workflows/ci.yml","style":["code"],"link":null,"image":false},{"text":" runs four jobs: Rust (fmt, clippy, test, doc, header verify), cargo deny, macOS (Rust library, swift-format, build, test, app bundle), and scripts (shellcheck, shfmt, actionlint, zizmor). Actions are pinned to commit hashes; Dependabot bumps them and Cargo dependencies weekly.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
