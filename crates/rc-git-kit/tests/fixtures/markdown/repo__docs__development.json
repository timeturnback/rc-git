{"kind":{"type":"paragraph"},"runs":[{"text":"The app's version needs no bump. ","style":[],"link":null,"image":false},{"text":"mac/Info.plist","style":["code"],"link":null,"image":false},{"text":" carries the major and minor of ","style":[],"link":null,"image":false},{"text":"CFBundleShortVersionString","style":["code"],"link":null,"image":false},{"text":"; ","style":[],"link":null,"image":false},{"text":"scripts/build-app.sh","style":["code"],"link":null,"image":false},{"text":" replaces the patch with the commit count, so ","style":[],"link":null,"image":false},{"text":"0.1.0","style":["code"],"link":null,"image":false},{"text":" in the template ships as ","style":[],"link":null,"image":false},{"text":"0.1.42","style":["code"],"link":null,"image":false},{"text":" and every commit on master moves it. Edit the template only to start a new series. The window titlebar shows that version beside its title, with a ","style":[],"link":null,"image":false},{"text":"+","style":["code"],"link":null,"image":false},{"text":" when the checkout was dirty at build time.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
{"kind":{"type":"paragraph"},"runs":[{"text":"scripts/build-app.sh","style":["code"],"link":null,"image":false},{"text":" stamps the rest into the bundle's ","style":[],"link":null,"image":false},{"text":"Info.plist","style":["code"],"link":null,"image":false},{"text":": ","style":[],"link":null,"image":false},{"text":"CFBundleVersion","style":["code"],"link":null,"image":false},{"text":" (the same commit count, as the monotonic build number), ","style":[],"link":null,"image":false},{"text":"RCGitVariant","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"RCGitSourceRoot","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"RCGitSourceCommit","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"RCGitSourceDirty","style":["code"],"link":null,"image":false},{"text":", and ","style":[],"link":null,"image":false},{"text":"RCGitBuildDate","style":["code"],"link":null,"image":false},{"text":". ","style":[],"link":null,"image":false},{"text":"AppBuild","style":["code"],"link":null,"image":false},{"text":" (RcGitKit) reads them; a bundle with no stamp reports itself as a dev build with no checkout to rebuild from, so it gets no menu item at all.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null}
