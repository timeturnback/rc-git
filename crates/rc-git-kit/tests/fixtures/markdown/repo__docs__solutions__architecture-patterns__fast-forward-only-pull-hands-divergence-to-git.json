{"kind":{"type":"paragraph"},"runs":[{"text":"mac/Tests/RcGitKitTests/ShellWordTests.swift","style":["code"],"link":null,"image":false},{"text":" runs adversarial words — a quote, ","style":[],"link":null,"image":false},{"text":"$HOME","style":["code"],"link":null,"image":false},{"text":", backticks, ","style":[],"link":null,"image":false},{"text":";","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"&&","style":["code"],"link":null,"image":false},{"text":", globs, braces, a tilde, ","style":[],"link":null,"image":false},{"text":"#","style":["code"],"link":null,"image":false},{"text":", ","style":[],"link":null,"image":false},{"text":"!","style":["code"],"link":null,"image":false},{"text":", a leading ","style":[],"link":null,"image":false},{"text":"=","style":["code"],"link":null,"image":false},{"text":", a newline, non-ASCII text, the empty word, and the bare word itself — through both ","style":[],"link":null,"image":false},{"text":"/bin/sh -c","style":["code"],"link":null,"image":false},{"text":" and ","style":[],"link":null,"image":false},{"text":"/bin/zsh -f -c","style":["code"],"link":null,"image":false},{"text":" running ","style":[],"link":null,"image":false},{"text":"printf %s <word>","style":["code"],"link":null,"image":false},{"text":", and checks each shell exits 0 and prints the word back unchanged. Writing the escape as ","style":[],"link":null,"image":false},{"text":"\\'","style":["code"],"link":null,"image":false},{"text":" instead of ","style":[],"link":null,"image":false},{"text":"'\\''","style":["code"],"link":null,"image":false},{"text":" fails it.","style":[],"link":null,"image":false}],"quoteDepth":0,"listDepth":0,"marker":null},
